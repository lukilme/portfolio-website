---
interface ProjectImage {
  src?: string;
  alt?: string;
  colorA?: string;
  colorB?: string;
}

interface Props {
  number: string;
  slug?: string;
  title: string;
  description: string;
  image?: ProjectImage;
  href?: string;
}

const { number, slug, title, description, image, href = '#' } = Astro.props;
const mediaSrc = image?.src;
const mediaAlt = image?.alt ?? title;
const fallbackBackground =
  image?.colorA && image?.colorB
    ? `linear-gradient(135deg, ${image.colorA} 0%, ${image.colorB} 100%)`
    : 'linear-gradient(135deg, #111111 0%, #7a7a7a 100%)';
---

<article class="project-card">
  <div class="visual">
    {mediaSrc ? (
      <img src={mediaSrc} alt={mediaAlt} loading="lazy" />
    ) : (
      <div class="fallback-visual" aria-hidden="true" style={`background: ${fallbackBackground};`}></div>
    )}
  </div>

  <div class="meta">
    <span class="number">{number}</span>
    <h2 data-project-id={slug} data-project-field="title">{title}</h2>
    <p data-project-id={slug} data-project-field="description">{description}</p>
    <a class="detail-link" href={href} data-i18n="projects.detail_cta">Detalhes →</a>
  </div>
</article>

<style>
  .project-card {
    display: grid;
    gap: 0.9rem;
    height: 100%;
    padding: 0.75rem;
    border: 2px solid var(--clr-text);
    background: var(--clr-surface);
    color: var(--clr-text);
    box-shadow: 6px 6px 0 var(--clr-text);
    transition: transform 120ms ease, box-shadow 120ms ease;
  }



  :global(html.theme-light) .project-card {
    background: #ffffff;
  }

  .project-card:hover,
  .project-card:focus-within {
    transform: translate(-2px, -2px);
    box-shadow: 8px 8px 0 var(--clr-text);
  }

  .visual {
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border: 2px solid var(--clr-text);
    background: var(--clr-bg);
  }

  .visual img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .fallback-visual {
    width: 100%;
    height: 100%;
  }

  .meta {
    display: grid;
    gap: 0.5rem;
  }

  .detail-link {
    display: inline-flex;
    align-items: center;
    width: fit-content;
    padding: 0.35rem 0.6rem;
    border: 2px solid var(--clr-text);
    background: var(--clr-bg);
    color: var(--clr-text);
    text-decoration: none;
    font-weight: 700;
  }

  .detail-link:hover,
  .detail-link:focus-visible {
    background: var(--clr-accent);
    color: var(--clr-bg);
  }

  .number {
    font-family: "Press Start 2P", "Microsoft Sans Serif", monospace;
    font-size: 0.6rem;
    letter-spacing: 0.08em;
    color: var(--clr-accent);


  }

  :global(html.theme-light) .number {
    color: var(--clr-text);
  }

  h2 {
    margin: 0;
    font-size: clamp(1.05rem, 2vw, 1.4rem);
    line-height: 1.2;
  }

  p {
    margin: 0;
    font-size: 0.95rem;
    line-height: 1.55;
    color: var(--clr-text-soft, var(--clr-text));
  }

  @media (max-width: 640px) {
    .project-card {
      padding: 0.65rem;
      box-shadow: 4px 4px 0 var(--clr-text);
    }
  }
</style>
