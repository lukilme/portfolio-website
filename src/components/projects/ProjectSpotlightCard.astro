---
interface Slide {
  id: string;
  colorA: string;
  colorB: string;
  src?: string;
  alt?: string;
}

interface Props {
  number: string;
  slug?: string;
  title: string;
  description: string;
  tech?: string[];
  slides?: Slide[];
  href?: string;
}

const { number, slug, title, description, tech = [], slides = [], href = '#' } = Astro.props;

// Sem imagens, o slide de reserva usa a cor do item (--accent, definida pela página)
const safeSlides: Slide[] =
  slides.length > 0
    ? slides
    : [{ id: 'fallback', colorA: 'var(--accent, #00e5ff)', colorB: '#05050a', alt: title }];
const hasMany = safeSlides.length > 1;

const techPalette = ['#ffe600', '#00e5ff', '#9b6bff', '#7dff3a', '#ff2bd6', '#ff6a00', '#67e8f9', '#fca5a5', '#c4b5fd', '#bbf7d0'];

const getTechStyle = (item: string, index: number) => {
  const hash = [...item].reduce((sum, char) => sum + char.charCodeAt(0), 0);
  return {
    '--tech-bg': techPalette[(hash + index) % techPalette.length],
  } as const;
};
---

<article class="featured" data-carousel>
  <div class="visual">
    <!-- Barra de título de janela: caminho + contador + controles -->
    <div class="bar">
      <span class="dots" aria-hidden="true"><i></i><i></i><i></i></span>
      <span class="path" aria-hidden="true">~/{slug ?? 'projeto'}/slides</span>

      {hasMany && (
        <div class="controls">
          <span class="counter" aria-live="polite">
            <span data-current>1</span>/{safeSlides.length}
          </span>
          <button type="button" data-dir="-1" aria-label="Imagem anterior">&lt;</button>
          <button type="button" data-dir="1" aria-label="Próxima imagem">&gt;</button>
        </div>
      )}
    </div>

    <div class="slides">
      {safeSlides.map((slide, i) => (
        <div
          class:list={['slide', { active: i === 0 }]}
          style={`background: linear-gradient(135deg, ${slide.colorA} 0%, ${slide.colorB} 100%);`}
          aria-hidden={i === 0 ? 'false' : 'true'}
        >
          {slide.src && <img src={slide.src} alt={slide.alt ?? `${title} — imagem ${i + 1}`} loading="lazy" />}
        </div>
      ))}
    </div>
  </div>

  <div class="body">
    <div class="meta">
      <span class="badge">{number}</span>
      <span class="kicker" data-i18n="projects.featured_label">Projeto principal</span>
    </div>
    <h2 data-project-id={slug} data-project-field="title">{title}</h2>
    <p data-project-id={slug} data-project-field="description">{description}</p>
    <ul class="tech" aria-label="Tecnologias utilizadas">
      {tech.map((item, index) => (
        <li style={getTechStyle(item, index)}>{item}</li>
      ))}
    </ul>
    <a class="detail-link" href={href} data-i18n="projects.detail_cta">Detalhes do projeto →</a>
  </div>
</article>

<script>
  document.querySelectorAll<HTMLElement>('[data-carousel]').forEach((root) => {
    const slides = [...root.querySelectorAll<HTMLElement>('.slide')];
    const counter = root.querySelector<HTMLElement>('[data-current]');
    if (slides.length < 2) return;

    let index = 0;
    let timer: number | undefined;

    const show = (next: number) => {
      index = (next + slides.length) % slides.length;
      slides.forEach((s, i) => {
        s.classList.toggle('active', i === index);
        s.setAttribute('aria-hidden', String(i !== index));
      });
      if (counter) counter.textContent = String(index + 1);
    };

    const stop = () => window.clearInterval(timer);
    const start = () => {
      if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      stop();
      timer = window.setInterval(() => show(index + 1), 5000);
    };

    root.querySelectorAll<HTMLButtonElement>('[data-dir]').forEach((btn) =>
      btn.addEventListener('click', () => {
        show(index + Number(btn.dataset.dir));
        start();
      })
    );

    root.addEventListener('mouseenter', stop);
    root.addEventListener('mouseleave', start);
    root.addEventListener('focusin', stop);
    root.addEventListener('focusout', start);
    start();
  });
</script>

<style>
  .featured {
    --accent-local: var(--accent, var(--clr-accent, #00e5ff));
    --on-accent-local: var(--on-accent, #05050a);

    display: flex;
    flex-direction: column;
    gap: 1rem;
    width: 100%;
    height: 100%;
    min-height: 35rem;
    padding: 0.75rem;
    border: 3px solid var(--clr-text);
    background: var(--clr-surface);
    color: var(--clr-text);
    box-shadow: 8px 8px 0 var(--accent-local);
    transition: transform 150ms steps(3), box-shadow 150ms steps(3);
  }

  :global(html.theme-light) .featured {
    background: #ffffff;
  }

  .featured:hover {
    transform: translate(-3px, -3px);
    box-shadow: 11px 11px 0 var(--accent-local);
  }

  /* ---------- Janela de imagens ---------- */
  .visual {
    position: relative;
    display: flex;
    flex-direction: column;
    width: 100%;
    min-height: 28rem;
    overflow: hidden;
    border: 3px solid var(--clr-text);
    background: var(--clr-bg);
  }

  .bar {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    min-height: 2.5rem;
    padding: 0.3rem 0.6rem;
    border-bottom: 3px solid var(--clr-text);
    background: var(--accent-local);
    color: var(--on-accent-local);
  }

  .dots {
    display: inline-flex;
    gap: 0.3rem;
  }

  .dots i {
    width: 0.6rem;
    height: 0.6rem;
    border: 2px solid var(--on-accent-local);
    background: transparent;
  }

  .dots i:first-child {
    background: var(--on-accent-local);
  }

  .path {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-family: ui-monospace, "SFMono-Regular", Menlo, Consolas, monospace;
    font-size: 0.75rem;
    font-weight: 700;
  }

  .controls {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    margin-left: auto;
  }

  .counter {
    padding: 0.25rem 0.5rem;
    border: 2px solid var(--on-accent-local);
    background: var(--clr-surface);
    color: var(--clr-text);
    font-family: "Press Start 2P", "Microsoft Sans Serif", monospace;
    font-size: 0.55rem;
  }

  .controls button {
    width: 1.9rem;
    height: 1.9rem;
    border: 2px solid var(--on-accent-local);
    background: var(--clr-surface);
    color: var(--clr-text);
    font-family: ui-monospace, "SFMono-Regular", Menlo, Consolas, monospace;
    font-size: 1rem;
    font-weight: 700;
    cursor: pointer;
  }

  .controls button:hover,
  .controls button:focus-visible {
    background: var(--on-accent-local);
    color: var(--accent-local);
  }

  .controls button:focus-visible,
  .detail-link:focus-visible {
    outline: 3px dashed var(--clr-text);
    outline-offset: 3px;
  }

  .slides {
    position: relative;
    flex: 1;
    width: 100%;
    min-height: 20rem;
  }

  /* Scanlines sobre a imagem */
  .slides::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background: repeating-linear-gradient(
      to bottom,
      transparent 0 2px,
      rgba(0, 0, 0, 0.12) 2px 3px
    );
  }

  .slide {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity 180ms steps(4);
  }

  .slide.active {
    opacity: 1;
  }

  .slide img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* ---------- Corpo ---------- */
  .body {
    display: flex;
    flex: 1 1 auto;
    flex-direction: column;
    gap: 0.8rem;
    padding: 0.25rem 0.25rem 0.5rem;
  }

  .meta {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 2.4rem;
    min-height: 2.4rem;
    padding: 0 0.35rem;
    border: 2px solid var(--clr-text);
    background: var(--accent-local);
    color: var(--on-accent-local);
    box-shadow: 3px 3px 0 var(--clr-text);
    font-family: "Press Start 2P", "Microsoft Sans Serif", monospace;
    font-size: 1rem;
  }

  .kicker {
    font-family: ui-monospace, "SFMono-Regular", Menlo, Consolas, monospace;
    font-size: 0.8rem;
    font-weight: 700;
  }

  .kicker::before {
    content: "// ";
    opacity: 0.6;
  }

  h2 {
    margin: 0;
    font-size: clamp(1.4rem, 3vw, 2rem);
    line-height: 1.1;
  }

  p {
    margin: 0;
    flex: 1 1 auto;
    line-height: 1.6;
  }

  .tech {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0;
    padding: 0.8rem 0 0;
    border-top: 2px dashed var(--clr-text);
    list-style: none;
  }

  .tech li {
    padding: 0.2rem 0.55rem;
    border: 2px solid var(--clr-text);
    background: var(--tech-bg, var(--clr-bg));
    color: var(--on-accent-local);
    font-family: ui-monospace, "SFMono-Regular", Menlo, Consolas, monospace;
    font-size: 0.72rem;
    font-weight: 700;
    box-shadow: 2px 2px 0 var(--clr-text);
  }

  .detail-link {
    display: inline-flex;
    width: fit-content;
    align-items: center;
    justify-content: center;
    margin-top: 0.4rem;
    padding: 0.5rem 0.9rem;
    border: 3px solid var(--clr-text);
    background: var(--accent-local);
    color: var(--on-accent-local);
    box-shadow: 4px 4px 0 var(--clr-text);
    text-decoration: none;
    font-weight: 700;
    transition: transform 120ms steps(2), box-shadow 120ms steps(2);
  }

  .detail-link:hover,
  .detail-link:focus-visible {
    transform: translate(-2px, -2px);
    box-shadow: 6px 6px 0 var(--clr-text);
  }

  @media (prefers-reduced-motion: reduce) {
    .featured,
    .detail-link,
    .slide {
      transition: none;
    }
    .featured:hover {
      transform: none;
    }
  }
</style>