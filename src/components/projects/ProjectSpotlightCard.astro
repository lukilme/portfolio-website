---
interface Slide {
  id: string;
  colorA: string;
  colorB: string;
  src?: string;
  alt?: string;
}

interface Props {
  number: string;
  slug?: string;
  title: string;
  description: string;
  tech?: string[];
  slides?: Slide[];
  href?: string;
}

const { number, slug, title, description, tech = [], slides = [], href = '#' } = Astro.props;
const safeSlides = slides.length > 0 ? slides : [{ id: 'fallback', colorA: '#111111', colorB: '#d9d9d1', alt: title }];
const hasMany = safeSlides.length > 1;
const techPalette = ['#facc15', '#7dd3fc', '#a78bfa', '#86efac', '#f9a8d4', '#fdba74', '#67e8f9', '#fca5a5', '#c4b5fd', '#bbf7d0'];

const getTechStyle = (item: string, index: number) => {
  const hash = [...item].reduce((sum, char) => sum + char.charCodeAt(0), 0);
  const tone = techPalette[(hash + index) % techPalette.length];

  return {
    '--tech-bg': tone,
    '--tech-border': tone,
    '--tech-text': '#111111',
  } as const;
};
---

<article class="featured" data-carousel>
  <div class="visual">
    <div class="slides">
      {safeSlides.map((slide, i) => (
        <div
          class:list={['slide', { active: i === 0 }]}
          style={`background: linear-gradient(135deg, ${slide.colorA} 0%, ${slide.colorB} 100%);`}
          aria-hidden={i === 0 ? 'false' : 'true'}
        >
          {slide.src && <img src={slide.src} alt={slide.alt ?? `${title} — imagem ${i + 1}`} loading="lazy" />}
        </div>
      ))}
    </div>

    {hasMany && (
      <div class="controls">
        <span class="counter" aria-live="polite">
          <span data-current>1</span>/{safeSlides.length}
        </span>
        <button type="button" data-dir="-1" aria-label="Imagem anterior">←</button>
        <button type="button" data-dir="1" aria-label="Próxima imagem">→</button>
      </div>
    )}
  </div>

  <div class="body">
    <div class="meta">
      <span class="badge">{number}</span>
      <span class="kicker" data-i18n="projects.featured_label">Projeto principal</span>
    </div>
    <h2 data-project-id={slug} data-project-field="title">{title}</h2>
    <p data-project-id={slug} data-project-field="description">{description}</p>
    <ul class="tech" aria-label="Tecnologias utilizadas">
      {tech.map((item, index) => (
        <li style={getTechStyle(item, index)}>{item}</li>
      ))}
    </ul>
    <a class="detail-link" href={href} data-i18n="projects.detail_cta">Detalhes do projeto →</a>
  </div>
</article>

<script>
  document.querySelectorAll<HTMLElement>('[data-carousel]').forEach((root) => {
    const slides = [...root.querySelectorAll<HTMLElement>('.slide')];
    const counter = root.querySelector<HTMLElement>('[data-current]');
    if (slides.length < 2) return;

    let index = 0;
    let timer: number | undefined;

    const show = (next: number) => {
      index = (next + slides.length) % slides.length;
      slides.forEach((s, i) => {
        s.classList.toggle('active', i === index);
        s.setAttribute('aria-hidden', String(i !== index));
      });
      if (counter) counter.textContent = String(index + 1);
    };

    const start = () => {
      if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      stop();
      timer = window.setInterval(() => show(index + 1), 5000);
    };
    const stop = () => window.clearInterval(timer);

    root.querySelectorAll<HTMLButtonElement>('[data-dir]').forEach((btn) =>
      btn.addEventListener('click', () => {
        show(index + Number(btn.dataset.dir));
        start();
      })
    );

    root.addEventListener('mouseenter', stop);
    root.addEventListener('mouseleave', start);
    root.addEventListener('focusin', stop);
    root.addEventListener('focusout', start);
    start();
  });
</script>

<style>
  .featured {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    width: 100%;
    height: 100%;
    min-height: 35rem;
    padding: 0.75rem;
    border: 2px solid var(--clr-text);
    background: var(--clr-surface);
    color: var(--clr-text);
    box-shadow: 8px 8px 0 var(--clr-text);
  }

  :global(html.theme-light) .featured {
    background: #ffffff;
    border-color: var(--clr-text);
    box-shadow: 8px 8px 0 var(--clr-text);
  }

  :global(html.theme-dark) .featured {
    background: var(--clr-surface);
  }

  .visual {
    position: relative;
    width: 100%;
    min-height: 20rem;
    overflow: hidden;
    border: 2px solid var(--clr-text);
    background: var(--clr-bg);
  }

  .slides {
    position: relative;
    width: 100%;
    height: 100%;
    min-height: 24rem;
  }

  .slide {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity 180ms ease;
  }

  .slide.active {
    opacity: 1;
  }

  .slide img {
    display: block;
    width: 90%;
    height: 100%;
    margin: auto;
    object-fit: cover;
  }

  .controls {
    position: absolute;
    right: 0.75rem;
    bottom: 0.75rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .counter {
    padding: 0.3rem 0.5rem;
    border: 2px solid var(--clr-text);
    background: var(--clr-surface);
    font-family: "Press Start 2P", "Microsoft Sans Serif", monospace;
    font-size: 0.55rem;
  }

  .controls button {
    width: 2rem;
    height: 2rem;
    border: 2px solid var(--clr-text);
    background: var(--clr-surface);
    color: var(--clr-text);
    font-weight: 700;
    cursor: pointer;
  }

  :global(html.theme-light) .number{
    color: var(--clr-text);
  }

  :global(html.theme-light) .controls button,
  :global(html.theme-light) .detail-link,
  :global(html.theme-light) .tech li {
    background: var(--clr-bg);
    color: var(--clr-text);
  }

  .controls button:hover {
    background: var(--clr-accent);
    color: var(--clr-bg);
  }

  :global(html.theme-light) .controls button:hover,
  :global(html.theme-light) .detail-link:hover,
  :global(html.theme-light) .detail-link:focus-visible {
    background: var(--clr-accent);
    color: var(--clr-bg);
  }

  .body {
    display: flex;
    flex: 1 1 auto;
    flex-direction: column;
    gap: 0.8rem;
    padding: 0.25rem 0.25rem 0.5rem;
  }

  .meta {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 2.4rem;
    min-height: 2.4rem;
    padding: 0 0.35rem;
    border: 2px solid var(--clr-text);
    background: var(--clr-accent);
    color: var(--clr-bg);
    font-family: "Press Start 2P", "Microsoft Sans Serif", monospace;
    font-size: 1rem;
  }

  :global(html.theme-light) .badge {
    background: var(--clr-text);
  }

  .kicker {
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  h2 {
    margin: 0;
    font-size: clamp(1.4rem, 3vw, 2rem);
    line-height: 1.1;
  }

  p {
    margin: 0;
    flex: 1 1 auto;
    line-height: 1.6;
  }

  .tech {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .tech li {
    padding: 0.2rem 0.55rem;
    border: 2px solid var(--tech-border, var(--clr-text));
    background: var(--tech-bg, var(--clr-bg));
    color: var(--tech-text, var(--clr-text));
    font-size: 0.72rem;
    font-weight: 700;
    box-shadow: 2px 2px 0 rgba(0, 0, 0, 0.15);
  }

  .detail-link {
    display: inline-flex;
    width: fit-content;
    align-items: center;
    justify-content: center;
    margin-top: auto;
    padding: 0.45rem 0.8rem;
    border: 2px solid var(--clr-text);
    background: var(--clr-bg);
    color: var(--clr-text);
    text-decoration: none;
    font-weight: 700;
  }

  .detail-link:hover,
  .detail-link:focus-visible {
    background: var(--clr-accent);
    color: var(--clr-bg);
  }

  @media (min-width: 52rem) {
    .featured {
      display: flex;
      flex-direction: column;
      align-items: stretch;
    }

    .visual {
      min-height: 22rem;
    }
  }
</style>