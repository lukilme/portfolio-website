---
import ThemeToggle from './ThemeToggle.astro';
import LanguageSwitcher from './LanguageSwitcher.astro';

// Remove a barra final para evitar "//projetos" (URL protocol-relative)
const base = (import.meta.env.BASE_URL || '/').replace(/\/+$/, '');

// Caminho atual sem o base, ex.: "/projetos"
const current = Astro.url.pathname
  .replace(base, '')
  .replace(/\/+$/, '');

const links = [
  { path: '',          key: 'nav.home',      label: 'Início' },
  { path: '/projetos', key: 'nav.projects',  label: 'Projetos' },
  { path: '/manifesto', key: 'nav.manifesto', label: 'Sobre' },
  { path: '/lab',      key: 'nav.lab',       label: 'Laboratório' },
];

const isActive = (path: string) =>
  path === '' ? current === '' : current === path || current.startsWith(path + '/');
---

<header class="site-header">
  <!-- Linha de prompt: mostra a rota atual como um caminho de shell -->
  <div class="prompt" aria-hidden="true">
    <span class="prompt-user" data-i18n="header.prompt_user">visitor</span><span class="prompt-at">@</span><span class="prompt-host">archive</span><span class="prompt-sep">:</span><span class="prompt-path">~{current || ''}</span><span class="prompt-sep">$</span>
    <span class="cursor"></span>
  </div>

  <a href={`${base}/`} class="site-logo" data-i18n-aria-label="header.logo_home" aria-label="portfolio::archive — página inicial">
    portfolio::archive
  </a>

  <nav aria-label="Navegação principal">
    <ul>
      {links.map((l) => (
        <li>
          <a
            href={`${base}${l.path}${l.path === '' ? '/' : ''}`}
            data-i18n={l.key}
            aria-current={isActive(l.path) ? 'page' : undefined}
          >{l.label}</a>
        </li>
      ))}
    </ul>
  </nav>

  <div class="header-controls">
    <ThemeToggle />
    <LanguageSwitcher />
  </div>
</header>

<style>
  .site-header {
    --glitch-a: #00f0ff;
    --glitch-b: #ff2bd6;
    --pixel: 6px;
    --header-accent-1: #ffe600;
    --header-accent-2: #00e5ff;
    --header-accent-3: #9b6bff;
    --header-accent-4: #7dff3a;
    --header-accent-5: #ff2bd6;
    --header-accent-6: #ff6a00;
    --header-accent-7: #67e8f9;
    --header-accent-8: #fca5a5;
    --header-accent-9: #c4b5fd;
    --header-accent-10: #bbf7d0;

    position: sticky;
    top: 0;
    z-index: 100;
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.75rem 1rem;
    padding: 0 1.25rem calc(0.9rem + var(--pixel));
    background: color-mix(in srgb, var(--clr-bg) 92%, transparent);
    backdrop-filter: blur(6px);
    border: 3px solid var(--clr-text);
    box-shadow: 6px 6px 0 var(--clr-text);
    color: var(--clr-text);
  }

  :global(html.theme-light) .site-header {
    --glitch-a: #0f766e;
    --glitch-b: #7c3aed;
    --header-accent-1: #facc15;
    --header-accent-2: #38bdf8;
    --header-accent-3: #a78bfa;
    --header-accent-4: #4ade80;
    --header-accent-5: #f472b6;
    --header-accent-6: #fb923c;
    --header-accent-7: #7dd3fc;
    --header-accent-8: #fda4af;
    --header-accent-9: #c4b5fd;
    --header-accent-10: #86efac;
  }

  :global(html.theme-light) nav a:hover,
  :global(html.theme-light) nav a:focus-visible {
    color: var(--clr-text);
  }

  /* Scanlines sutis (CRT) */
  .site-header::before {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: repeating-linear-gradient(
      to bottom,
      transparent 0 2px,
      color-mix(in srgb, var(--clr-text) 6%, transparent) 2px 3px
    );
  }

  /* Faixa pixelada (dither) na borda inferior */
  .site-header::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: var(--pixel);
    pointer-events: none;
    image-rendering: pixelated;
    background:
      conic-gradient(
        var(--clr-text) 25%,
        transparent 0 50%,
        var(--clr-text) 0 75%,
        transparent 0
      ) 0 0 / calc(var(--pixel) * 2) calc(var(--pixel) * 2);
    border-top: 2px solid var(--clr-text);
  }

  /* ---------- Prompt de terminal ---------- */
  .prompt {
    flex: 1 0 100%;
    display: flex;
    align-items: center;
    gap: 0.4ch;
    padding: 0.35rem 0;
    border-bottom: 2px dashed var(--clr-text);
    font-family: ui-monospace, "SFMono-Regular", Menlo, Consolas, monospace;
    font-size: 0.75rem;
    line-height: 1.2;
    white-space: nowrap;
    overflow: hidden;
  }

  .prompt-user {
    font-weight: 700;
    color: var(--header-accent-2);
  }

  .prompt-host {
    color: var(--header-accent-1);
    font-weight: 700;
  }

  .prompt-at {
    color: var(--header-accent-5);
  }

  .prompt-path {
    color: var(--header-accent-1);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .prompt-sep {
    opacity: 0.6;
    color: var(--header-accent-5);
  }

  .cursor {
    display: inline-block;
    width: 0.6ch;
    height: 1em;
    background: currentColor;
    animation: blink 1s steps(1) infinite;
  }

  @keyframes blink {
    50% { opacity: 0; }
  }

  /* ---------- Logo ---------- */
  .site-logo {
    padding-top: 0.25rem;
    font-family: "Press Start 2P", "Microsoft Sans Serif", monospace;
    font-size: 0.8rem;
    color: var(--clr-text);
    text-decoration: none;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    line-height: 1.4;
  }

  .site-logo:hover,
  .site-logo:focus-visible {
    color: var(--clr-text);
    text-shadow: -2px 0 var(--header-accent-2), 2px 0 var(--header-accent-5), 4px 0 var(--header-accent-1);
    outline: none;
  }

  .site-logo:focus-visible {
    outline: 3px dashed var(--clr-text);
    outline-offset: 4px;
  }

  /* ---------- Navegação ---------- */
  nav ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  nav li { margin: 0; }

  nav li:nth-child(1) a { --nav-accent: var(--header-accent-1); }
  nav li:nth-child(2) a { --nav-accent: var(--header-accent-2); }
  nav li:nth-child(3) a { --nav-accent: var(--header-accent-3); }
  nav li:nth-child(4) a { --nav-accent: var(--header-accent-4); }

  nav a {
    display: inline-block;
    padding: 0.5rem 0.75rem;
    border: 2px solid var(--clr-text);
    background: var(--clr-surface);
    box-shadow: 2px 2px 0 var(--nav-accent, var(--header-accent-2));
    font-family: "Press Start 2P", "Microsoft Sans Serif", monospace;
    font-size: 0.6rem;
    color: var(--clr-text);
    text-decoration: none;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    transition: transform 150ms steps(3), box-shadow 150ms steps(3), background 150ms steps(3);
  }

  /* Colchetes via CSS: não interferem na troca de texto do i18n */
  nav a::before { content: "["; margin-right: 0.5ch; opacity: 0.6; }
  nav a::after  { content: "]"; margin-left: 0.5ch; opacity: 0.6; }

  nav a:hover,
  nav a:focus-visible {
    color: var(--clr-bg);
    background: var(--nav-accent, var(--header-accent-2));
    transform: translate(-2px, -2px);
    box-shadow: 3px 3px 0 var(--clr-text);
    outline: none;
  }

  nav a:focus-visible {
    outline: 3px dashed var(--clr-text);
    outline-offset: 3px;
  }

  /* Página atual: bloco invertido, como seleção no terminal */
  nav a[aria-current="page"] {
    background: var(--clr-text);
    color: var(--clr-bg);
  }
  nav a[aria-current="page"]::before { content: ">"; opacity: 1; }
  nav a[aria-current="page"]::after  { content: ""; margin: 0; }

  /* ---------- Controles ---------- */
  .header-controls {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  /* ---------- Mobile ---------- */
  @media (max-width: 40rem) {
    .site-header { padding-inline: 0.9rem; }
    nav { flex: 1 0 100%; order: 3; }
    nav ul { display: grid; grid-template-columns: 1fr 1fr; }
    nav a { display: block; text-align: left; }
    .header-controls { margin-left: auto; }
  }

  @media (prefers-reduced-motion: reduce) {
    .cursor { animation: none; }
    nav a { transition: none; }
  }
</style>