---
import ThemeToggle from './ThemeToggle.astro';
import LanguageSwitcher from './LanguageSwitcher.astro';

const basePath = import.meta.env.BASE_URL || '/';
---

<header class="site-header">
  <a href={basePath} class="site-logo" aria-label="signal::archive — página inicial">
    signal::archive
  </a>

  <nav aria-label="Navegação principal">
    <ul>
      <li>
        <a href={basePath} data-i18n="nav.home">Início</a>
      </li>
      <li>
        <a href={`${basePath}/manifesto`} data-i18n="nav.manifesto">Manifesto</a>
      </li>
      <li>
        <a href={`${basePath}/lab`} data-i18n="nav.lab">Laboratório</a>
      </li>
    </ul>
  </nav>

  <div class="header-controls">
    <ThemeToggle />
    <LanguageSwitcher />
  </div>
</header>

<style>
  .site-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1rem;
    padding: 0.9rem 1.25rem;
    background: var(--clr-bg);
    border: 3px solid var(--clr-text);
    box-shadow: 6px 6px 0 var(--clr-text);
    color: var(--clr-text);
  }

  .site-logo {
    font-family: "Press Start 2P", "Microsoft Sans Serif", monospace;
    font-size: 0.8rem;
    color: var(--clr-text);
    text-decoration: none;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    line-height: 1.4;
  }

  .site-logo:hover,
  .site-logo:focus-visible {
    color: var(--clr-text);
    text-decoration: underline;
    text-underline-offset: 0.2em;
    outline: none;
  }

  nav ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  nav li {
    margin: 0;
  }

  nav a {
    display: inline-block;
    padding: 0.5rem 0.75rem;
    border: 2px solid var(--clr-text);
    background: var(--clr-surface);
    font-family: "Press Start 2P", "Microsoft Sans Serif", monospace;
    font-size: 0.6rem;
    color: var(--clr-text);
    text-decoration: none;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    transition: transform 150ms ease, box-shadow 150ms ease, background 150ms ease;
  }

  nav a:hover,
  nav a:focus-visible {
    color: var(--clr-bg);
    background: var(--clr-highlight);
    transform: translate(-2px, -2px);
    box-shadow: 3px 3px 0 var(--clr-text);
    outline: none;
  }

  .header-controls {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
</style>
