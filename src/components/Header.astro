---
import ThemeToggle from './ThemeToggle.astro';
import LanguageSwitcher from './LanguageSwitcher.astro';

const base = (import.meta.env.BASE_URL || '/').replace(/\/+$/, '');

const current = Astro.url.pathname
  .replace(base, '')
  .replace(/\/+$/, '');

const links = [
  { path: '',          key: 'nav.home',      label: 'Início' },
  { path: '/projetos', key: 'nav.projects',  label: 'Projetos' },
  { path: '/manifesto', key: 'nav.manifesto', label: 'Sobre' },
  { path: '/lab',      key: 'nav.lab',       label: 'Laboratório' },
];

const isActive = (path: string) =>
  path === '' ? current === '' : current === path || current.startsWith(path + '/');

interface Props {
  title?: string;
  description?: string;
  lang?: 'pt' | 'en';
}

const {
  title = 'portfolio::archive',
  description = 'Portfolio pessoal e archive de projetos, interfaces e pensamento digital.',
  lang = 'pt',
} = Astro.props;
const path = Astro.url.pathname === '/' ? '~' : `~${Astro.url.pathname.replace(/\/$/, '')}`;

---

<div class="site-header" role="banner">
  <!-- Linha de prompt: mostra a rota atual como um caminho de shell -->
   <div class="prompt"> 
      <div class="sys-bar" aria-hidden="true">
  
      <span class="sys-bar__prompt">
        <b>root@sys</b><span class="sys-bar__sep">:</span><span class="sys-bar__path">{path}</span><span class="sys-bar__sep">$</span><span class="sys-bar__caret"></span>
      </span>
      <span class="sys-bar__status">
        <i class="sys-bar__dot"></i>
        <span data-pt="sistema online" data-en="system online">sistema online</span>
      </span>
      <span class="sys-bar__meta">
        <span id="sys-clock">--:--:--</span>
        <span class="sys-bar__pct"><span id="sys-pct">000</span>%</span>
      </span>
  </div>
   </div>

  
  <a href={`${base}/`} class="site-logo" data-i18n-aria-label="header.logo_home" aria-label={`${title} — página inicial`}>
    {title}
  </a>

  <nav aria-label="Navegação principal">
    <ul>
      {links.map((l) => (
        <li>
          <a
            href={`${base}${l.path}${l.path === '' ? '/' : ''}`}
            data-i18n={l.key}
            aria-current={isActive(l.path) ? 'page' : undefined}
          >{l.label}</a>
        </li>
      ))}
    </ul>
  </nav>

  <div class="header-controls">
    <ThemeToggle />
    <LanguageSwitcher />
  </div>
</div>

<style>
  .site-header {
    --glitch-a: #00f0ff;
    --glitch-b: #ff2bd6;
    --pixel: 6px;
    --header-accent-1: #ffe600;
    --header-accent-2: #00e5ff;
    --header-accent-3: #9b6bff;
    --header-accent-4: #7dff3a;
    --header-accent-5: #ff2bd6;
    --header-accent-6: #ff6a00;
    --header-accent-7: #67e8f9;
    --header-accent-8: #fca5a5;
    --header-accent-9: #c4b5fd;
    --header-accent-10: #bbf7d0;

    position: sticky;
    top: 0;
    z-index: 100;
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.5rem 1rem;
    padding: 0 0.6rem calc(0.9rem + var(--pixel));
    background: color-mix(in srgb, var(--clr-bg) 92%, transparent);
    backdrop-filter: blur(6px);
    border: 3px solid var(--clr-text);
    box-shadow: 6px 6px 0 var(--clr-text);
    color: var(--clr-text);
  }

  :global(html.theme-light) .site-header {
    --glitch-a: #0f766e;
    --glitch-b: #9333ea;

    /* Paleta de alto contraste para fundo claro */
    --header-accent-1: #a16207; /* Amarelo/âmbar */
    --header-accent-2: #0369a1; /* Azul */
    --header-accent-3: #7e22ce; /* Roxo */
    --header-accent-4: #15803d; /* Verde */
    --header-accent-5: #be185d; /* Rosa */
    --header-accent-6: #c2410c; /* Laranja */
    --header-accent-7: #0e7490; /* Ciano */
    --header-accent-8: #be123c; /* Vermelho */
    --header-accent-9: #6d28d9; /* Violeta */
    --header-accent-10: #047857; /* Esmeralda */
  }

  :global(html.theme-light) nav a:hover,
  :global(html.theme-light) nav a:focus-visible {
    color: var(--clr-text);
  }

  /* Scanlines sutis (CRT) */
  .site-header::before {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: repeating-linear-gradient(
      to bottom,
      transparent 0 2px,
      color-mix(in srgb, var(--clr-text) 6%, transparent) 2px 3px
    );
  }

  /* Faixa pixelada (dither) na borda inferior */
  .site-header::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: var(--pixel);
    pointer-events: none;
    image-rendering: pixelated;
    background:
      conic-gradient(
        var(--clr-text) 25%,
        transparent 0 50%,
        var(--clr-text) 0 75%,
        transparent 0
      ) 0 0 / calc(var(--pixel) * 2) calc(var(--pixel) * 2);
    border-top: 2px solid var(--clr-text);
  }

  /* ---------- Prompt de terminal ---------- */
  .prompt {
    flex: 1 0 100%;
    width: 100%;
    display: block;
    padding: 0;
    border-bottom: 2px dashed var(--clr-text);
    font-family: ui-monospace, "SFMono-Regular", Menlo, Consolas, monospace;
    font-size: 0.75rem;
    line-height: 1.2;
    white-space: nowrap;
    overflow: hidden;
  }

  .sys-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    width: 100%;
    min-height: 2.5rem;
    padding: 0.35rem 0.75rem;
    background: color-mix(in srgb, var(--clr-bg) 80%, var(--clr-text) 20%);
    border-bottom: 2px solid var(--clr-text);
    color: var(--clr-text);
    font-family: ui-monospace, "SFMono-Regular", Menlo, Consolas, monospace;
    font-size: 0.72rem;
    line-height: 1.2;
    box-sizing: border-box;
  }

  .prompt-user {
    font-weight: 700;
    color: var(--header-accent-2);
  }

  .prompt-host {
    color: var(--header-accent-1);
    font-weight: 700;
  }

  .prompt-at {
    color: var(--header-accent-5);
  }

  .prompt-path {
    color: var(--header-accent-1);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .prompt-sep {
    opacity: 0.6;
    color: var(--header-accent-5);
  }

  .cursor {
    display: inline-block;
    width: 0.6ch;
    height: 1em;
    background: currentColor;
    animation: blink 1s steps(1) infinite;
  }

  @keyframes blink {
    50% { opacity: 0; }
  }

  /* ---------- Logo ---------- */
  .site-logo {
    padding-top: 0.25rem;
    font-family: "Press Start 2P", "Microsoft Sans Serif", monospace;
    font-size: 0.8rem;
    color: var(--clr-text);
    text-decoration: none;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    line-height: 1.4;
  }
  .sys-bar__prompt {
    display: inline-flex;
    align-items: center;
    min-width: 0;
    overflow: hidden;
    flex: 1 1 auto;
  }
  .sys-bar__prompt b { color: var(--c-lime); font-weight: 800; }
  .sys-bar__sep { color: var(--c-magenta); margin: 0 0.15rem; }
  .sys-bar__path { color: var(--c-cyan); overflow: hidden; text-overflow: ellipsis; }

  .sys-bar__caret {
    display: inline-block;
    width: 0.55em;
    height: 1em;
    margin-left: 0.35rem;
    background: var(--c-yellow);
    animation: blink 1s steps(1) infinite;
  }

  .sys-bar__status { display: inline-flex; align-items: center; gap: 0.5rem; color: var(--c-lime); }
  .sys-bar__dot {
    width: 8px;
    height: 8px;
    background: var(--c-lime);
    box-shadow: 0 0 0 2px var(--on-accent), 0 0 0 4px var(--c-lime);
    animation: blink 2s steps(1) infinite;
  }

  .sys-bar__meta { display: inline-flex; gap: 0.9rem; color: var(--c-yellow); font-variant-numeric: tabular-nums; }
  .sys-bar__pct { color: var(--c-orange); }


    .px-notch {
    --n: var(--px);
    clip-path: polygon(
      0 var(--n), var(--n) var(--n), var(--n) 0,
      calc(100% - var(--n)) 0, calc(100% - var(--n)) var(--n), 100% var(--n),
      100% calc(100% - var(--n)), calc(100% - var(--n)) calc(100% - var(--n)), calc(100% - var(--n)) 100%,
      var(--n) 100%, var(--n) calc(100% - var(--n)), 0 calc(100% - var(--n))
    );
  }

  /* Caixa brutalista com sombra dura */
  .brut-box {
    border: var(--bw) solid var(--clr-text);
    background: var(--clr-surface);
    box-shadow: var(--shadow-hard);
  }

  /* Prompt de terminal antes do texto */
  .t-prompt::before {
    content: '> ';
    color: var(--c-lime);
    font-weight: 800;
  }

  /* Cursor piscante */
  .t-caret::after {
    content: '';
    display: inline-block;
    width: 0.6em;
    height: 1em;
    margin-left: 0.2em;
    vertical-align: -0.12em;
    background: var(--c-lime);
    animation: caret 1s steps(1) infinite;
  }

  .site-logo:hover,
  .site-logo:focus-visible {
    color: var(--clr-text);
    text-shadow: -2px 0 var(--header-accent-2), 2px 0 var(--header-accent-5), 4px 0 var(--header-accent-1);
    outline: none;
  }

  .site-logo:focus-visible {
    outline: 3px dashed var(--clr-text);
    outline-offset: 4px;
  }

  /* ---------- Navegação ---------- */
  nav ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  nav li { margin: 0; }

  nav li:nth-child(1) a { --nav-accent: var(--header-accent-1); }
  nav li:nth-child(2) a { --nav-accent: var(--header-accent-2); }
  nav li:nth-child(3) a { --nav-accent: var(--header-accent-3); }
  nav li:nth-child(4) a { --nav-accent: var(--header-accent-4); }

  nav a {
    display: inline-block;
    padding: 0.5rem 0.75rem;
    border: 2px solid var(--clr-text);
    background: var(--clr-surface);
    box-shadow: 2px 2px 0 var(--nav-accent, var(--header-accent-2));
    font-family: "Press Start 2P", "Microsoft Sans Serif", monospace;
    font-size: 0.6rem;
    color: var(--clr-text);
    text-decoration: none;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    transition: transform 150ms steps(3), box-shadow 150ms steps(3), background 150ms steps(3);
  }

  /* Colchetes via CSS: não interferem na troca de texto do i18n */
  nav a::before { content: "["; margin-right: 0.5ch; opacity: 0.6; }
  nav a::after  { content: "]"; margin-left: 0.5ch; opacity: 0.6; }

  nav a:hover,
  nav a:focus-visible {
    color: var(--clr-bg);
    background: var(--nav-accent, var(--header-accent-2));
    transform: translate(-2px, -2px);
    box-shadow: 3px 3px 0 var(--clr-text);
    outline: none;
  }

  nav a:focus-visible {
    outline: 3px dashed var(--clr-text);
    outline-offset: 3px;
  }

  /* Página atual: bloco invertido, como seleção no terminal */
  nav a[aria-current="page"] {
    background: var(--clr-text);
    color: var(--clr-bg);
  }
  nav a[aria-current="page"]::before { content: ">"; opacity: 1; }
  nav a[aria-current="page"]::after  { content: ""; margin: 0; }

  /* ---------- Controles ---------- */
  .header-controls {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  /* ---------- Mobile ---------- */
  @media (max-width: 40rem) {
    .site-header { padding-inline: 0.9rem; }
    nav { flex: 1 0 100%; order: 3; }
    nav ul { display: grid; grid-template-columns: 1fr 1fr; }
    nav a { display: block; text-align: left; }
    .header-controls { margin-left: auto; }
  }

  @media (prefers-reduced-motion: reduce) {
    .cursor { animation: none; }
    nav a { transition: none; }
  }
</style>

<script>

  // ---------- Relógio + progresso de scroll ----------
  const clock = document.getElementById('sys-clock');
  const pct = document.getElementById('sys-pct');
  const fill = document.getElementById('scroll-fill');

  function tick() {
    if (clock) clock.textContent = new Date().toLocaleTimeString('pt-BR', { hour12: false });
  }
  tick();
  setInterval(tick, 1000);

  let queued = false;
  function paintScroll() {
    queued = false;
    const max = document.documentElement.scrollHeight - window.innerHeight;
    const p = max > 0 ? Math.min(100, Math.max(0, (window.scrollY / max) * 100)) : 0;
    const stepped = Math.round(p / 4) * 4; // degraus de 4% = visual pixelado
    if (fill) fill.style.width = `${stepped}%`;
    if (pct) pct.textContent = String(Math.round(p)).padStart(3, '0');
  }
  function onScroll() {
    if (queued) return;
    queued = true;
    requestAnimationFrame(paintScroll);
  }
  window.addEventListener('scroll', onScroll, { passive: true });
  window.addEventListener('resize', onScroll, { passive: true });
  paintScroll();



</script>