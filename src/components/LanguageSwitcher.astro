---
import pt from '../i18n/pt.json';
import en from '../i18n/en.json';
import { projectTranslations } from '../data/projects';

const translations = { pt, en };
---

<button
  type="button"
  id="language-switcher-btn"
  class="language-switcher"
  aria-label="Switch to English"
>
  <span aria-hidden="true">PT</span>
</button>

<style>
  .language-switcher {
    min-width: 3rem;
    height: 2.5rem;
    padding: 0 0.75rem;
    background: var(--clr-surface);
    color: var(--clr-text);
    border: 2px solid var(--clr-text);
    box-shadow: 3px 3px 0 var(--clr-text);
    cursor: pointer;
    font-family: "Press Start 2P", "Microsoft Sans Serif", monospace;
    font-size: 0.55rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    transition: transform 150ms ease, box-shadow 150ms ease, background 150ms ease;
  }

  .language-switcher:hover,
  .language-switcher:focus-visible {
    background: var(--clr-highlight);
    color: var(--clr-bg);
    transform: translate(-2px, -2px);
    box-shadow: 5px 5px 0 var(--clr-text);
    outline: none;
  }
</style>

<script define:vars={{ translations, projectTranslations }}>
  const button = document.getElementById('language-switcher-btn');

  if (button) {
    const getTranslation = (lang, key) => {
      const value = key.split('.').reduce((current, part) => {
        if (current && typeof current === 'object') {
          return current[part];
        }
        return undefined;
      }, translations[lang]);
      return typeof value === 'string' ? value : undefined;
    };

    const translateProjectCopy = (lang) => {
      document.querySelectorAll('[data-project-id]').forEach((element) => {
        const projectId = element.dataset.projectId;
        const field = element.dataset.projectField;
        if (!projectId || !field) return;

        const project = projectTranslations[projectId];
        if (!project) return;

        const copy = project[lang] ?? project.pt;
        if (!copy) return;

        if (field === 'title') {
          element.textContent = copy.title;
        }

        if (field === 'description') {
          element.textContent = copy.description;
        }

        if (field === 'longDescription') {
          element.textContent = copy.longDescription;
        }

        if (field === 'details') {
          const items = copy.details ?? [];
          element.innerHTML = items.map((item) => `<li>${item}</li>`).join('');
        }
      });
    };

    const translatePage = (lang) => {
      document.querySelectorAll('[data-i18n]').forEach((element) => {
        const translation = getTranslation(lang, element.dataset.i18n ?? '');
        if (translation) element.textContent = translation;
      });

      document.querySelectorAll('[data-i18n-aria-label]').forEach((element) => {
        const translation = getTranslation(lang, element.dataset.i18nAriaLabel ?? '');
        if (translation) element.setAttribute('aria-label', translation);
      });

      translateProjectCopy(lang);
    };

    const update = (lang) => {
      const isEnglish = lang === 'en';
      button.querySelector('span').textContent = isEnglish ? 'EN' : 'PT';
      button.setAttribute('aria-label', isEnglish ? 'Mudar para Português' : 'Switch to English');
    };

    const currentLanguage = () => document.documentElement.lang === 'en' ? 'en' : 'pt';
    translatePage(currentLanguage());
    update(currentLanguage());

    button.addEventListener('click', () => {
      const nextLanguage = currentLanguage() === 'pt' ? 'en' : 'pt';
      document.documentElement.lang = nextLanguage;
      window.__grm_lang = nextLanguage;
      translatePage(nextLanguage);

      try {
        localStorage.setItem('grm-lang', nextLanguage);
      } catch (_) {
        // Language switching still applies for the current session.
      }

      update(nextLanguage);
    });
  }
</script>