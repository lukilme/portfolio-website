---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  lang?: 'pt' | 'en';
}

const { title, description, lang = 'pt' } = Astro.props;
---

<!doctype html>
<html lang={lang} class="theme-dark">
  <head>
    <BaseHead title={title} description={description} lang={lang} />
    <script is:inline>
      try {
        const stored = localStorage.getItem('grm-lang');
        const language = stored === 'en' || stored === 'pt' ? stored : 'pt';
        document.documentElement.lang = language;
        window.__grm_lang = language;
      } catch (_) {
        document.documentElement.lang = 'pt';
        window.__grm_lang = 'pt';
      }
    </script>
  </head>
  <body>
    <Header />
    <main class="site-main">
      <slot />
    </main>
    <footer class="site-footer">
      <small data-i18n="footer.copyright">© Grimório.exe — todos os feitiços reservados</small>
    </footer>
  </body>
</html>

<style>
  .site-main {
    min-height: calc(100dvh - 8rem);
  }

  .site-footer {
    margin-top: 2rem;
    padding: 1.25rem 1rem;
    border-top: 3px solid var(--clr-text);
    background: var(--clr-surface);
    color: var(--clr-text);
    text-align: center;
    box-shadow: 0 -6px 0 var(--clr-text);
  }

  .site-footer small {
    margin-top: 1rem;
    margin-bottom: 4rem;
    display: inline-block;
    padding: 0.4rem 0.75rem;
    border: 2px solid var(--clr-text);
    background: var(--clr-bg);
    color: var(--clr-text);
    font-family: "Press Start 2P", "Microsoft Sans Serif", monospace;
    font-size: 1rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    line-height: 1.6;
  }

  :global(html.theme-light) .site-footer {
    background: #ffffff;
  }

  :global(html.theme-light) .site-footer small {
    background: #f5f5f0;
  }
</style>
