---
import Layout from '../layouts/Layout.astro';
import ProjectSpotlightCard from '../components/projects/ProjectSpotlightCard.astro';
import ProjectMiniCard from '../components/projects/ProjectMiniCard.astro';
import { featuredProjects, secondaryProjects } from '../data/projects';

// Sem barra final, para não gerar "//projetos" (URL protocol-relative)
const base = (import.meta.env.BASE_URL || '/').replace(/\/+$/, '');

// Cada projeto recebe uma cor da paleta, em rodízio
const palette = ['cyan', 'magenta', 'yellow', 'lime', 'orange', 'violet'];
const accent = (i: number) => `--accent: var(--c-${palette[i % palette.length]})`;
---

<Layout
  title="Projetos | portfolio::archive"
  description="Projetos, experimentos e sistemas desenvolvidos com foco em clareza, arquitetura e interface."
  lang="pt"
>
  <main class="page-shell">
    <header class="page-header">
      <p class="eyebrow" data-i18n="projects.eyebrow">Projetos</p>
      <h1 data-i18n="projects.heading">Sistemas, protótipos e interfaces em produção.</h1>
    </header>
    
    <section class="block featured-block" aria-labelledby="featured-title">
      <div class="block-head">
        <h2 id="featured-title" class="block-title" data-i18n="projects.featured_title">Projetos em destaque</h2>
        <span class="block-count">{String(featuredProjects.length).padStart(2, '0')}</span>
      </div>

      <ul class="featured-list">
        {featuredProjects.map((project, i) => (
          <li style={accent(i)}>
            <span class="slot" aria-hidden="true">./{project.slug}</span>
            <ProjectSpotlightCard
              number={project.number}
              slug={project.slug}
              title={project.title}
              description={project.description}
              tech={project.tech ?? []}
              slides={project.slides ?? []}
              href={`${base}/projetos/${project.slug}`}
            />
          </li>
        ))}
      </ul>
    </section>

    <div class="color-stripe" aria-hidden="true"></div> 

    <section class="block secondary-block" aria-labelledby="secondary-title">
      <div class="block-head block-head--quiet">
        <h2 id="secondary-title" class="block-title" data-i18n="projects.secondary_title">Outros trabalhos</h2>
        <span class="block-count">{String(secondaryProjects.length).padStart(2, '0')}</span>
      </div>

      <div class="dither" aria-hidden="true"></div>

      <ul class="mini-grid">
        {secondaryProjects.map((project, i) => (
          <li style={accent(i + featuredProjects.length)}>
            <ProjectMiniCard
              number={project.number}
              slug={project.slug}
              title={project.title}
              description={project.description}
              image={project.image}
              href={`${base}/projetos/${project.slug}`}
            />
          </li>
        ))}
      </ul>
    </section>
  </main>
</Layout>

<style>

  .page-shell {
    --c-cyan: #00e5ff;
    --c-magenta: #ff2bd6;
    --c-yellow: #ffe600;
    --c-lime: #7dff3a;
    --c-orange: #ff6a00;
    --c-violet: #9b6bff;
    --on-accent: #05050a;
    --accent: var(--c-cyan);

    position: relative;
    isolation: isolate;
    max-width: 72rem;
    margin: 0 auto;
    padding: 10vh 1.5rem 5rem;
    color: var(--clr-text);
    background: var(--clr-bg);



  }
  

  :global(html.theme-light) .page-shell {
    background: linear-gradient(180deg, #f5f5f0 0%, #ffffff 100%);
  }


  .dither {
    display: block;
    width: 100%;
    height: 16px;
    margin: 0 0 1.75rem;
    --f-cyan: var(--c-cyan, #00e5ff);
    --f-magenta: var(--c-magenta, #ff2bd6);
    --f-yellow: var(--c-yellow, #ffe600);
    --f-lime: var(--c-lime, #7dff3a);
    --f-orange: var(--c-orange, #ff6a00);
    --f-violet: var(--c-violet, #9b6bff);
    --f-ink: var(--on-accent, #05050a);
    --f-paper: #e9e9f2;
    --f-line: 4px;
    background:
      repeating-conic-gradient(var(--f-ink) 0 25%, transparent 0 50%) 0 0 / 8px 8px,
      linear-gradient(
        90deg,
        var(--f-cyan) 0 16.66%,
        var(--f-magenta) 0 33.33%,
        var(--f-yellow) 0 50%,
        var(--f-lime) 0 66.66%,
        var(--f-orange) 0 83.33%,
        var(--f-violet) 0 100%
      );
    image-rendering: pixelated;
    border-bottom: var(--f-line) solid var(--f-paper);
    box-sizing: border-box;
    position: relative;
    overflow: hidden;
  }

  .dither::before {
    content: "";
    position: absolute;
    inset: 0;
    background: repeating-linear-gradient(
      to bottom,
      transparent 0 3px,
      rgb(255 255 255 / 0.035) 3px 4px
    );
    pointer-events: none;
  }

  /* Grade cyber ao fundo */
  .page-shell::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    background-image:
      linear-gradient(color-mix(in srgb, var(--c-cyan) 16%, transparent) 1px, transparent 1px),
      linear-gradient(90deg, color-mix(in srgb, var(--c-magenta) 12%, transparent) 1px, transparent 1px);
    background-size: 32px 32px;
  }

  /* ---------- Cabeçalho da página ---------- */
  .page-header {
    max-width: 48rem;
    margin-bottom: 4rem;
  }

  .eyebrow {
    display: inline-block;
    margin: 0 0 1.25rem;
    padding: 0.45rem 0.7rem;
    border: 2px solid var(--clr-text);
    background: var(--c-lime);
    color: var(--on-accent);
    box-shadow: 3px 3px 0 var(--clr-text);
    font-family: "Press Start 2P", "Microsoft Sans Serif", monospace;
    font-size: 0.6rem;
    letter-spacing: 0.08em;
  }

  .eyebrow::before {
    content: "$ ";
    opacity: 0.7;
  }

  h1 {
    margin: 0;
    font-size: clamp(2.1rem, 5vw, 4rem);
    line-height: 1.1;
  }

  /* Barra segmentada em blocos duros, estilo pixel */
  h1::after {
    content: "";
    display: block;
    width: min(100%, 20rem);
    height: 10px;
    margin-top: 1.5rem;
    background: linear-gradient(
      90deg,
      var(--c-cyan) 0 25%,
      var(--c-magenta) 0 50%,
      var(--c-yellow) 0 75%,
      var(--c-lime) 0
    );
    border: 2px solid var(--clr-text);
    box-sizing: content-box;
  }

  /* ---------- Cabeçalhos de bloco: barra de título de janela ---------- */
  .block {
    color: var(--clr-text);
  }

  .block-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1.75rem;
    padding: 0.6rem 0.9rem;
    border: 3px solid var(--clr-text);
    background: var(--c-magenta);
    color: var(--on-accent);
    box-shadow: 6px 6px 0 var(--clr-text);
  }

  .block-title {
    margin: 0;
    font-size: 1.25rem;
    color: var(--on-accent);
  }

  .block-count {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 2.5rem;
    min-height: 2.5rem;
    padding: 0.35rem 0.5rem;
    border: 2px solid var(--on-accent);
    background: var(--c-yellow);
    color: var(--on-accent);
    font-family: "Press Start 2P", "Microsoft Sans Serif", monospace;
    font-size: 0.6rem;
    box-shadow: 3px 3px 0 var(--on-accent);
  }

  /* Bloco secundário: mais calmo, só contorno tracejado */
  .block-head--quiet {
    background: transparent;
    color: var(--clr-text);
    border: 2px dashed var(--c-cyan);
    box-shadow: none;
  }

  .block-head--quiet .block-title {
    font-size: 1rem;
    color: var(--clr-text);
  }

  .block-head--quiet .block-count {
    background: var(--c-cyan);
    border-color: var(--clr-text);
    box-shadow: 3px 3px 0 var(--clr-text);
  }

  /* ---------- Listas ---------- */
  .featured-list,
  .mini-grid {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .featured-block {
    margin-bottom: 5rem;
  }

  .featured-list {
    display: grid;
    align-items: stretch;
    gap: 3.5rem;
    padding-right: 10px;
    padding-bottom: 10px;
  }

  .featured-list li,
  .mini-grid li {
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  /* O card ocupa o resto da altura do item */
  .featured-list li > :global(*:last-child),
  .mini-grid li > :global(*:last-child) {
    flex: 1;
  }

  /* Aba com o caminho do projeto, na cor do item */
  .slot {
    align-self: flex-start;
    margin-left: 1rem;
    padding: 0.3rem 0.7rem;
    border: 3px solid var(--clr-text);
    border-bottom: 0;
    background: var(--accent);
    color: var(--on-accent);
    font-family: ui-monospace, "SFMono-Regular", Menlo, Consolas, monospace;
    font-size: 0.75rem;
    font-weight: 700;
    line-height: 1.2;
  }

  .mini-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(16rem, 1fr));
    gap: 1.5rem;
    padding-right: 5px;
    padding-bottom: 5px;
  }

  @media (max-width: 40rem) {
    .page-shell { padding-inline: 1rem; }
    .featured-list { gap: 2.5rem; }
    .block-head { box-shadow: 4px 4px 0 var(--clr-text); }
  }
</style>