---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="signal::archive"
  description="Arquitetura digital, interfaces e sistemas com clareza, consistência e intenção."
>
  <main class="page-shell">
    <header class="page-header">
      <p class="eyebrow" data-i18n="site.tagline">Arquitetura digital em código puro</p>
      <h1 data-i18n="index.hero_heading">signal::archive</h1>
    </header>

    <section class="block intro-block" aria-labelledby="intro-title">
      <div class="block-head">
        <h2 id="intro-title" class="block-title">Arquitetura da informação em sistemas funcionais</h2>
        <span class="block-count">01</span>
      </div>

      <div class="intro-panel">
        <p class="mission" data-i18n="index.mission">
          Transformo arquitetura da informação em interfaces funcionais, consistentes e com memória.
        </p>

        <div class="meta-grid" aria-label="Resumo do trabalho">
          <article class="meta-item">
            <span class="meta-label">Foco</span>
            <strong>Design de sistema</strong>
          </article>
          <article class="meta-item">
            <span class="meta-label">Fluxo</span>
            <strong>Produto + interface</strong>
          </article>
          <article class="meta-item">
            <span class="meta-label">Resultado</span>
            <strong>Clareza em código</strong>
          </article>
        </div>

        <div class="cta-row">
          <a class="contact" href="/projetos">Ver projetos</a>
        </div>
      </div>
    </section>
  </main>
</Layout>

<style>
  .page-shell {
    --c-cyan: #00e5ff;
    --c-magenta: #ff2bd6;
    --c-yellow: #ffe600;
    --c-lime: #7dff3a;
    --c-orange: #ff6a00;
    --c-violet: #9b6bff;
    --on-accent: #05050a;
    --accent: var(--c-cyan);

    position: relative;
    isolation: isolate;
    max-width: 72rem;
    margin: 0 auto;
    padding: 10vh 1.5rem 5rem;
    color: var(--clr-text);
    background: var(--clr-bg);
  }

  :global(html.theme-light) .page-shell {
    background: linear-gradient(180deg, #f5f5f0 0%, #ffffff 100%);
  }

  .page-shell::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    background-image:
      linear-gradient(color-mix(in srgb, var(--c-cyan) 16%, transparent) 1px, transparent 1px),
      linear-gradient(90deg, color-mix(in srgb, var(--c-magenta) 12%, transparent) 1px, transparent 1px);
    background-size: 32px 32px;
  }

  .page-header {
    max-width: 48rem;
    margin-bottom: 4rem;
  }

  .eyebrow {
    display: inline-block;
    margin: 0 0 1.25rem;
    padding: 0.45rem 0.7rem;
    border: 2px solid var(--clr-text);
    background: var(--c-lime);
    color: var(--on-accent);
    box-shadow: 3px 3px 0 var(--clr-text);
    font-family: "Press Start 2P", "Microsoft Sans Serif", monospace;
    font-size: 0.6rem;
    letter-spacing: 0.08em;
  }

  .eyebrow::before {
    content: "$ ";
    opacity: 0.7;
  }

  h1 {
    margin: 0;
    font-size: clamp(2.1rem, 5vw, 4rem);
    line-height: 1.1;
    color: var(--clr-accent);
  }

  h1::after {
    content: "";
    display: block;
    width: min(100%, 20rem);
    height: 10px;
    margin-top: 1.5rem;
    background: linear-gradient(
      90deg,
      var(--c-cyan) 0 25%,
      var(--c-magenta) 0 50%,
      var(--c-yellow) 0 75%,
      var(--c-lime) 0
    );
    border: 2px solid var(--clr-text);
    box-sizing: content-box;
  }

  .block {
    color: var(--clr-text);
  }

  .block-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1.75rem;
    padding: 0.6rem 0.9rem;
    border: 3px solid var(--clr-text);
    background: var(--c-magenta);
    color: var(--on-accent);
    box-shadow: 6px 6px 0 var(--clr-text);
  }

  .block-title {
    margin: 0;
    font-size: 1.25rem;
    color: var(--on-accent);
  }

  .block-count {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 2.5rem;
    min-height: 2.5rem;
    padding: 0.35rem 0.5rem;
    border: 2px solid var(--on-accent);
    background: var(--c-yellow);
    color: var(--on-accent);
    font-family: "Press Start 2P", "Microsoft Sans Serif", monospace;
    font-size: 0.6rem;
    box-shadow: 3px 3px 0 var(--on-accent);
  }

  .intro-panel {
    display: grid;
    gap: 2rem;
    padding: clamp(1.25rem, 2vw, 2rem);
    border: 3px solid var(--clr-text);
    background: rgba(12, 13, 20, 0.72);
    box-shadow: 8px 8px 0 var(--clr-text);
  }

  :global(html.theme-light) .intro-panel {
    background: rgba(255, 255, 255, 0.85);
  }

  .mission {
    max-width: 42rem;
    margin: 0;
    font-size: clamp(1.1rem, 3vw, 1.5rem);
    line-height: 1.5;
  }

  .meta-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr));
    gap: 1rem;
  }

  .meta-item {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 1rem;
    border: 2px solid var(--clr-text);
    background: var(--c-cyan);
    color: var(--on-accent);
    box-shadow: 4px 4px 0 var(--clr-text);
  }

  .meta-label {
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    opacity: 0.8;
  }

  .meta-item strong {
    font-size: 1rem;
    line-height: 1.3;
  }

  .cta-row {
    display: flex;
    align-items: center;
    justify-content: flex-start;
  }

  .contact {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.8rem 1.2rem;
    border: 3px solid var(--clr-text);
    background: var(--c-yellow);
    color: var(--on-accent);
    font-weight: 700;
    text-decoration: none;
    box-shadow: 4px 4px 0 var(--clr-text);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .contact:hover {
    transform: translate(-2px, -2px);
    box-shadow: 6px 6px 0 var(--clr-text);
  }

  @media (max-width: 40rem) {
    .page-shell { padding-inline: 1rem; }
    .block-head { box-shadow: 4px 4px 0 var(--clr-text); }
    .intro-panel { box-shadow: 5px 5px 0 var(--clr-text); }
  }
</style>