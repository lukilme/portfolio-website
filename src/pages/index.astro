---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="signal::archive"
  description="Arquitetura digital, interfaces e sistemas com clareza, consistência e intenção."
>
  <section class="home-hero">
      <p class="eyebrow" data-i18n="site.tagline">Arquitetura digital em código puro</p>
      <h1 data-i18n="index.hero_heading">signal::archive</h1>
      <p class="mission" data-i18n="index.mission">Transformo arquitetura da informação em interfaces funcionais, consistentes e com memória.</p>
      <a class="contact" href="mailto:hello@signalarchive.dev" data-i18n="index.contact_cta">Entre em contato</a>
  </section>
</Layout>

<style>
  .home-hero {
    max-width: 56rem;
    margin: 0 auto;
    padding: 12vh 1.5rem;
  }

  .eyebrow {
    color: var(--clr-accent);
    margin-bottom: 1.5rem;
  }

  h1 {
    font-size: clamp(2rem, 8vw, 5rem);
    color: var(--clr-accent);
    overflow-wrap: anywhere;
  }

  .mission {
    max-width: 42rem;
    margin: 2rem 0;
    font-size: clamp(1.1rem, 3vw, 1.5rem);
  }

  .contact {
    display: inline-block;
    padding: 0.75rem 1rem;
    color: var(--clr-bg);
    background: var(--clr-accent);
    font-weight: bold;
  }
</style>