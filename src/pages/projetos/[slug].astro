---
import Layout from '../../layouts/Layout.astro';
import { allProjects, getProjectBySlug } from '../../data/projects';

export function getStaticPaths() {
  return allProjects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

const { project } = Astro.props;
const currentProject = project ?? getProjectBySlug(Astro.params.slug ?? '');

if (!currentProject) {
  throw new Error('Projeto não encontrado.');
}

const basePath = import.meta.env.BASE_URL || '/';
const techPalette = ['#facc15', '#7dd3fc', '#a78bfa', '#86efac', '#f9a8d4', '#fdba74', '#67e8f9', '#fca5a5', '#c4b5fd', '#bbf7d0'];

const getTechStyle = (item: string, index: number) => {
  const hash = [...item].reduce((sum, char) => sum + char.charCodeAt(0), 0);
  const tone = techPalette[(hash + index) % techPalette.length];

  return {
    '--tech-bg': tone,
    '--tech-border': tone,
    '--tech-text': '#111111',
  } as const;
};

const visualBackground =
  currentProject.image?.colorA && currentProject.image?.colorB
    ? `linear-gradient(135deg, ${currentProject.image.colorA} 0%, ${currentProject.image.colorB} 100%)`
    : 'linear-gradient(135deg, #111111 0%, #7a7a7a 100%)';
---

<Layout
  title={`${currentProject.title} | signal::archive`}
  description={currentProject.longDescription}
  lang="pt"
>
  <main class="project-page">
    <a class="back-link" href={`${basePath}/projetos/`} data-i18n="projects.back_to_projects">← Voltar para projetos</a>

    <header class="hero">
      <div class="hero-copy">
        <p class="eyebrow" data-i18n="projects.project_label">Projeto</p>
        <h2 data-project-id={currentProject.slug} data-project-field="title">{currentProject.title}</h2>
        <p class="summary" data-project-id={currentProject.slug} data-project-field="longDescription">{currentProject.longDescription}</p>
      </div>

      <div class="hero-visual" style={`background: ${visualBackground};`}>
        {currentProject.image?.src ? (
          <img src={currentProject.image.src} alt={currentProject.image.alt ?? currentProject.title} loading="eager" />
        ) : currentProject.slides?.[0]?.src ? (
          <img src={currentProject.slides[0].src} alt={currentProject.slides[0].alt ?? currentProject.title} loading="eager" />
        ) : null}
      </div>
    </header>

    <section class="content">
      <div class="section-block">
        <h2 data-i18n="projects.summary_label">Resumo</h2>
        <p data-project-id={currentProject.slug} data-project-field="description">{currentProject.description}</p>
      </div>

      {currentProject.tech && currentProject.tech.length > 0 && (
        <div class="section-block">
          <h2 data-i18n="projects.technologies_label">Tecnologias</h2>
          <ul class="tech-list">
            {currentProject.tech.map((item, index) => (
              <li style={getTechStyle(item, index)}>{item}</li>
            ))}
          </ul>
        </div>
      )}

      <div class="section-block">
        <h2 data-i18n="projects.details_label">Detalhes</h2>
        <ul class="detail-list" data-project-id={currentProject.slug} data-project-field="details">
          {currentProject.details.map((item) => <li>{item}</li>)}
        </ul>
      </div>
    </section>
  </main>
</Layout>

<style>
  .project-page {
    max-width: 62rem;
    margin: 0 auto;
    padding: 9vh 1.5rem 5rem;
  }

  .back-link {
    display: inline-block;
    margin-bottom: 2rem;
    color: var(--clr-text);
    text-decoration: none;
    font-weight: 700;
  }

  .hero {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    align-items: stretch;
    margin-bottom: 2.5rem;
  }

  .eyebrow {
    margin: 0 0 1rem;
    color: var(--clr-accent);
    font-family: "Press Start 2P", "Microsoft Sans Serif", monospace;
    font-size: 0.6rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  h2 {
    margin: 0 0 1rem;
    font-size: clamp(1.5rem, 4vw, 3rem);
    line-height: 1.05;
  }

  .summary {
    margin: 0;
    max-width: 42rem;
    font-size: clamp(1.00rem, 1.5vw, 1.0rem);
    line-height: 1.6;
  }

  .hero-visual {
    width: min(100%, 52rem);
    min-height: 26rem;
    margin: 0 auto;
    border: 2px solid var(--clr-text);
    box-shadow: 8px 8px 0 var(--clr-text);
    overflow: hidden;
  }

  .hero-visual img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
    background: rgba(255, 255, 255, 0.04);
  }

  .content {
    display: grid;
    gap: 2rem;
  }

  .section-block {
    padding: 1.2rem 1.1rem;
    border: 2px solid var(--clr-text);
    background: var(--clr-surface);
    color: var(--clr-text);
    box-shadow: 6px 6px 0 var(--clr-text);
  }

  :global(html.theme-light) .section-block {
    background: #ffffff;
  }

  .section-block h2 {
    margin-top: 0;
    margin-bottom: 0.8rem;
    font-size: 1.1rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .section-block p,
  .detail-list {
    margin: 0;
    line-height: 1.7;
  }

  .tech-list,
  .detail-list {
    margin: 0;
    padding-left: 1.2rem;
  }

  .tech-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    padding-left: 0;
    list-style: none;
  }

  .tech-list li {
    padding: 0.25rem 0.6rem;
    border: 2px solid var(--tech-border, var(--clr-text));
    background: var(--tech-bg, var(--clr-bg));
    color: var(--tech-text, var(--clr-text));
    font-size: 0.75rem;
    font-weight: 700;
    box-shadow: 2px 2px 0 rgba(0, 0, 0, 0.15);
  }

  :global(html.theme-light) .tech-list li {
    background: var(--tech-bg, #f5f5f0);
  }

  .detail-list li + li {
    margin-top: 0.65rem;
  }

  @media (min-width: 52rem) {
    .hero {
      display: flex;
      flex-direction: column;
      align-items: center;
    }

    .hero-copy {
      width: min(100%, 52rem);
      text-align: left;
    }
  }
</style>
